# Copy to .env.local and fill in from Supabase: Project Settings > API Keys. Never commit .env.local.
# These are the only two variables this app uses. Never add a service-role / sb_secret_ key anywhere.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Safe in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
